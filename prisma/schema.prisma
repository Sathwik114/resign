generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

model EsiEmployee {
  ESIID              String   @unique(map: "UQ_EsiEmployee_ESIID") @default(dbgenerated()) @db.NVarChar(20)
  EmpID              String   @id @db.NVarChar(50)
  EmpName            String   @db.NVarChar(200)
  DOJ                DateTime @db.Date
  DOB                DateTime @db.Date
  Gender             String   @db.NVarChar(20)
  MobileNo           String   @db.VarChar(10)
  AadharNo           String   @db.VarChar(12)
  MaritalStatus      String   @db.NVarChar(20)
  HasPrevESI         Boolean
  PrevESINo          String?  @db.VarChar(20)
  Address            String   @db.NVarChar(Max)
  State              String   @db.NVarChar(100)
  Pincode            String   @db.VarChar(6)
  EmpImg             Bytes    @db.VarBinary(Max)
  PhotographMimeType String   @db.VarChar(100)

  FatherName          String    @db.NVarChar(200)
  MotherName          String    @db.NVarChar(200)
  SpouseName          String?   @db.NVarChar(200)
  SpouseDOB           DateTime? @db.Date
  SpouseImg           Bytes?    @db.VarBinary(Max)
  SpousePhotoMimeType String?   @db.VarChar(100)

  ChildCount          Int       @default(0)
  Child1Name          String?   @db.NVarChar(200)
  Child1DOB           DateTime? @db.Date
  Child1Img           Bytes?    @db.VarBinary(Max)
  Child1PhotoMimeType String?   @db.VarChar(100)
  Child2Name          String?   @db.NVarChar(200)
  Child2DOB           DateTime? @db.Date
  Child2Img           Bytes?    @db.VarBinary(Max)
  Child2PhotoMimeType String?   @db.VarChar(100)
  Child3Name          String?   @db.NVarChar(200)
  Child3DOB           DateTime? @db.Date
  Child3Img           Bytes?    @db.VarBinary(Max)
  Child3PhotoMimeType String?   @db.VarChar(100)
  Child4Name          String?   @db.NVarChar(200)
  Child4DOB           DateTime? @db.Date
  Child4Img           Bytes?    @db.VarBinary(Max)
  Child4PhotoMimeType String?   @db.VarChar(100)
  Child5Name          String?   @db.NVarChar(200)
  Child5DOB           DateTime? @db.Date
  Child5Img           Bytes?    @db.VarBinary(Max)
  Child5PhotoMimeType String?   @db.VarChar(100)

  IncludeParents      Boolean
  FatherDOB           DateTime? @db.Date
  FatherImg           Bytes?    @db.VarBinary(Max)
  FatherPhotoMimeType String?   @db.VarChar(100)
  MotherDOB           DateTime? @db.Date
  MotherImg           Bytes?    @db.VarBinary(Max)
  MotherPhotoMimeType String?   @db.VarChar(100)
  Verification        String    @default("Not Verified") @db.VarChar(20)
  VerifiedBy          String?   @db.NVarChar(200)
  VerifiedAt          DateTime? @db.DateTime2

  CreatedAt DateTime @default(now()) @db.DateTime2
  UpdatedAt DateTime @updatedAt @db.DateTime2

  @@map("EsiEmployee")
}

model ResignLoginMast {
  EmpCode String @unique @db.VarChar(10)
  EmpName String @db.VarChar(50)

  @@map("ResignLoginMast")
}
